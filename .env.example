# ============================================================
# AI 新闻简报 Agent 环境变量（复制为 .env 并按需填写）
# 必填只有一项：LLM_API_KEY
# ============================================================

# 【必填】DeepSeek API Key（https://platform.deepseek.com/ 申请）
LLM_API_KEY=

# 模型接口（OpenAI 兼容格式，默认 DeepSeek；一般无需修改）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 新闻来源：demo=使用 fixtures 固定虚构样例（默认，无网络抓取，可复现）
#           rss=实时抓取 RSS（阶段二实现）
NEWS_SOURCE=demo

# 真实模式的 RSS 源（逗号分隔，阶段二生效；2026-10-17 实测直连可达）
RSS_SOURCES=https://hnrss.org/newest?q=AI,https://techcrunch.com/category/artificial-intelligence/feed/,https://www.jiqizhixin.com/rss

# 每日定时生成时间（Asia/Shanghai，24 小时制 HH:MM）
DAILY_RUN_AT=08:00

# 可选：覆盖 bash 工具的命令二进制目录
#（默认自动探测 Git for Windows 的 usr/bin，探测失败时才需要设置）
# TOOL_BIN_DIR=C:\Program Files\Git\usr\bin
